---
export const prerender = false;
import SiteLayout from "@/layouts/SiteLayout.astro";
import { createRequestSupabase } from "@/lib/server/supabase";
import { formatRupees } from "@/lib/site";
const client = createRequestSupabase(Astro.cookies, Astro.request);
let booking: { reference: string; service_name_snapshot: string; starts_at: string; ends_at: string; status: string; payment_status: string; total_paise: number; advance_due_paise: number; balance_due_paise: number; timezone: string } | null = null;
if (client) {
  const { data: { user } } = await client.auth.getUser();
  if (!user) return Astro.redirect("/account/login");
  const { data } = await client.from("bookings")
    .select("reference,service_name_snapshot,starts_at,ends_at,status,payment_status,total_paise,advance_due_paise,balance_due_paise,timezone")
    .eq("id", Astro.params.id ?? "").maybeSingle();
  booking = data;
}
---
<SiteLayout title="Booking details" noindex={true}>
  {booking ? <section class="page-hero"><span class="eyebrow">BOOKING {booking.reference}</span><h1>{booking.service_name_snapshot}<br /><em>at a glance.</em></h1><p>{new Date(booking.starts_at).toLocaleString("en-IN", { dateStyle: "full", timeStyle: "short", timeZone: booking.timezone })}</p><div class="detail-facts"><span>Status: {booking.status.replaceAll("_", " ")}</span><span>Payment: {booking.payment_status.replaceAll("_", " ")}</span></div><p>Total {formatRupees(booking.total_paise)} · Advance {formatRupees(booking.advance_due_paise)} · Balance {formatRupees(booking.balance_due_paise)}</p><a class="text-link" href="/account/bookings">All bookings <span aria-hidden="true">↗</span></a></section> : <section class="page-hero"><span class="eyebrow">BOOKING DETAILS</span><h1>Your visit,<br /><em>at a glance.</em></h1><p>This booking was not found, or it does not belong to your account.</p><a class="text-link" href="/account">Back to your account <span aria-hidden="true">↗</span></a></section>}
</SiteLayout>
